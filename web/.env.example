# ==============================================================================
# NORDIC-OMNI — environment template
# Copy to .env.local and fill in. Generate SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (self-hosted PostgreSQL) ----------------------------------------
# User-scoped (RLS applies). In production this must NOT be the table owner.
DATABASE_URL=postgres://omni_app:CHANGE_ME@127.0.0.1:54330/nordic_omni
# Owner connection (bypasses RLS). Only webhooks and the login lookup use this.
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:54330/nordic_omni

# --- Session signing ----------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS

# --- LiveKit ------------------------------------------------------------------
# Local dev server:  livekit-server --dev   (uses devkey/secret)
# Production:        wss://eu-project-xxxx.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Must match agent-worker/main.py. Named dispatch avoids stale-worker routing.
LIVEKIT_AGENT_NAME=nordic-omni

# --- LiveKit Inference --------------------------------------------------------
# Used by the AI Brain compiler and customer web chat. The LiveKit key above is
# exchanged for a short-lived inference token server-side.
# LIVEKIT_INFERENCE_URL=https://agent-gateway.livekit.cloud/v1
# INFERENCE_LLM_MODEL=google/gemini-2.5-flash

# --- Owner escalation workflow -----------------------------------------------
# Optional N8N webhook. It receives signed escalation JSON and can send SMS,
# ring the owner, or create a task. Without it, escalations are recorded only.
# N8N_ESCALATION_WEBHOOK_URL=https://n8n.example.dk/webhook/omni-escalation
# N8N_WEBHOOK_SECRET=change-me

# --- LLM brain ----------------------------------------------------------------
# DeepSeek is preferred; Groq is the fallback. Without either, the app labels
# its deterministic replies as fallbacks and never pretends to be an LLM.
DEEPSEEK_API_KEY=
# GROQ_API_KEY=

# --- Meta webhook -------------------------------------------------------------
META_VERIFY_TOKEN=nordic_omni_verify
# Required to verify X-Hub-Signature-256 on inbound webhooks.
META_APP_SECRET=
