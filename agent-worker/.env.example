# ==============================================================================
# Voice worker environment. Copy to agent-worker/.env and fill in.
# ==============================================================================

# --- LiveKit Cloud ------------------------------------------------------------
# Create a free project at https://cloud.livekit.io (no credit card).
# Project Settings -> Keys -> copy the URL, API key and secret.
# Use an EU project for Danish production traffic.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must match the web token route. Do not use unnamed/default dispatch in production.
LIVEKIT_AGENT_NAME=nordic-omni

# --- PostgreSQL ---------------------------------------------------------------
# Owner-level connection. The worker is a trusted backend component and always
# filters explicitly by tenant_id.
DATABASE_URL=postgres://postgres@127.0.0.1:54330/nordic_omni

# One accepted call at a time on an 8 GB host. Raise only after load testing.
MAX_CONCURRENT_CALLS=1

# --- Owner escalation workflow (optional) ------------------------------------
# N8N receives signed escalation JSON and can send SMS, call the owner, or create
# a task. Without it, voice escalations are recorded but no owner is notified.
# N8N_ESCALATION_WEBHOOK_URL=https://n8n.example.dk/webhook/omni-escalation
# N8N_WEBHOOK_SECRET=change-me

# --- Model overrides (optional) ----------------------------------------------
# Leave blank to use the defaults below. Danish speech quality improves a lot
# with a provider that has proper da-DK voices.
# Defaults: STT_MODEL=deepgram/nova-3  LLM_MODEL=google/gemini-2.5-flash
#           TTS_MODEL=cartesia/sonic-3
STT_MODEL=
LLM_MODEL=
TTS_MODEL=
# Optional explicit voice id, e.g. a Danish voice from the chosen TTS provider.
TTS_VOICE=

# --- Microsoft Azure Speech (optional) ---------------------------------------
# Client #1 uses Azure TTS: da-DK-ChristelNeural.
# Set TTS_MODEL=azure (or STT_MODEL=azure)
# Best Danish neural voices: da-DK-ChristelNeural (female), da-DK-JeppeNeural (male)
# Best English neural voices: en-US-JennyNeural, en-US-GuyNeural, en-US-AriaNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral

